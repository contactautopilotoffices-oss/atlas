# God's Eye (/godseye/). Set these in Vercel: Project > Settings > Environment Variables.
# The desk runs on Engy (engy.ai) when ENGY_API_KEY is set, otherwise on Claude.
ENGY_API_KEY=
# Optional. Any OpenAI-compatible endpoint works here.
# ENGY_BASE_URL=https://api.engy.ai/v1
# Optional. Exa (exa.ai) checks the question and top signals before the model runs,
# and gives tool-capable models a search_web tool.
EXA_API_KEY=
# Optional alternative provider.
# ANTHROPIC_API_KEY=
# Optional. Force a provider: engy or claude.
# GODSEYE_PROVIDER=engy
# The passcode people type into the God's Eye gate. Pick something long.
GODSEYE_ACCESS_KEY=
# Optional. Defaults to engy/deepseek-v4-flash-0731 on Engy, claude-opus-5 on Claude.
# GODSEYE_MODEL=engy/deepseek-v4-flash-0731

# Existing ATLAS build config
MAPBOX_TOKEN=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Atlas design gallery: server-only. Never add secrets to config.js or browser code.
# Reuses the CMS Supabase/auth service; apply migration 019 before production use.
SUPABASE_SERVICE_ROLE_KEY=
CMS_SESSION_SECRET=
# Copy the complete credential from https://open.higgsfield.ai/api-keys into
# Vercel > Project Settings > Environment Variables. Never paste it into chat.
HIGGSFIELD_API_KEY=
# This configures credentials only: room generation stays disabled until a
# native render worker and geometry-review integration are available.
# Explicit local-only preview (never set in production):
# ATLAS_DESIGN_LOCAL_PREVIEW=1
# ATLAS_DESIGN_LOCAL_INDEX=/tmp/atlas-reference-library/reviewed-index.json
# ATLAS_DESIGN_LOCAL_OBJECTS=/tmp/atlas-reference-library/objects
# Native worker and optional Higgsfield visualization (server/worker only).
# ATLAS_BLENDER_BIN=/Applications/Blender.app/Contents/MacOS/Blender
# ATLAS_DESIGN_WORKSPACE=/absolute/private/workspace
# Set to 1 only after authorizing paid Higgsfield use; each request still
# requires an explicit single-image authorization in the gallery.
# ATLAS_DESIGN_ALLOW_PAID_ENHANCEMENT=0
