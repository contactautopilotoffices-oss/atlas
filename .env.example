# God's Eye (/godseye/). Set these in Vercel: Project > Settings > Environment Variables.
# The desk runs on Engy (engy.ai) when ENGY_API_KEY is set, otherwise on Claude.
ENGY_API_KEY=
# Optional. Any OpenAI-compatible endpoint works here.
# ENGY_BASE_URL=https://api.engy.ai/v1
# Optional. Exa (exa.ai) checks the question and top signals before the model runs,
# and gives tool-capable models a search_web tool.
EXA_API_KEY=
# Optional alternative provider.
# ANTHROPIC_API_KEY=
# Optional. Force a provider: engy or claude.
# GODSEYE_PROVIDER=engy
# Optional. Overrides the God's Eye gate passcode kept in api/godseye/_lib.js.
# GODSEYE_ACCESS_KEY=
# Optional. Defaults to engy/deepseek-v4-flash-0731 on Engy, claude-opus-5 on Claude.
# GODSEYE_MODEL=engy/deepseek-v4-flash-0731

# Existing ATLAS build config
MAPBOX_TOKEN=
SUPABASE_URL=
SUPABASE_ANON_KEY=
