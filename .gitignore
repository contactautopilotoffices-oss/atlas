# Test screenshots and temp files
*.png
*.jpg
*.jpeg
!autopilot-logo*.png
trim-*.ps1

# Property media: curated photos DO commit (small, and the gallery needs them).
# Videos never do — 78MB of clips belongs in Supabase Storage, not git history.
!media/**/*.jpg
!media/**/*.jpeg
!media/**/*.png
*.mp4
*.MP4
*.mov
*.MOV

# F1 Skymark twin: the audit preview and the stills from Blender commit with the page
!noida-skymark/**/*.png
!noida-skymark/**/*.jpg
*.blend1

# Landlord page (/landlord/, a copy of the f1-skymark-landlord repo): its photos, logos and its two
# short videos (hero reel and ARCIL CEO, about 9 MB) ship with the page, which plays them on iPhone too
!landlord/**/*.jpg
!landlord/**/*.png
!landlord/**/*.mp4


# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
node_modules/
/config.js
.env

# client proposal (third-party PII) & bulky source
*.pdf
prd.txt
osm.xml
osm2.xml

# 4K PNG masters from the upscale pass — working files, served copies live alongside originals
media/_enhanced/

# Indore sign-in backdrop is copied in at build time (scripts/fetch-indore-backdrop.js)
media/indore/backdrop-*.webp

# CMS local development store and uploads (npm run dev:cms)
.cms-dev-store.json
media/_cms-dev/
/docs-out/

# Copernicus surface model tile, fetched by noida-skymark/reconstruction/fetch_context.py
.dsm_*.tif

# Facade textures painted at build time by scripts/world/textures.py
noida-skymark/reconstruction/.tex/
__pycache__/

# F1 Skymark twin builder: .blend files, renders, bakes and GLBs are build output, never committed
noida-skymark/twin/_build/
noida-skymark/twin/web/_review/
noida-skymark/twin/assets/
**/*.blend
**/*.blend1
**/*.raw.glb
**/*.exr

# Reliable Tech Park twin (Altruist): the page's own images ship with it (logo, DWG blueprints, exterior lightmaps,
# renders, G0 sheets and seat plans). Raw drawing previews in airoli-rtp/review and Blender masters stay local.
!airoli-rtp/twin/web/**/*.png
!airoli-rtp/twin/web/**/*.jpg
!airoli-rtp/brand/*.png
!airoli-rtp/brand/*.jpg
!airoli-rtp/rtp*/*.png
airoli-rtp/exterior/stills/*.hdr

# RTP presentation runtime assets; local captures and generation masters stay out of Git.
!airoli-rtp/experience/assets/**/*.png
!airoli-rtp/experience/assets/**/*.jpg
!airoli-rtp/interior-semantic/captures/presentation/*.png
airoli-rtp/experience/assets/geo/raw/
airoli-rtp/experience/models/_build/
airoli-rtp/experience/review/
airoli-rtp/experience/reference/
airoli-rtp/film-src/
airoli-rtp/film/.hyperframes/
airoli-rtp/film/assets/
airoli-rtp/film/captures/
airoli-rtp/film/renders/
airoli-rtp/film/review/
airoli-rtp/film/narration-v2/*.wav
airoli-rtp/film/narration-v2/*.mp3
airoli-rtp/film/narration-v2/*take*.json
airoli-rtp/film/narration-v2/*transcript*.json
airoli-rtp/film/narration-v2/*.log
airoli-rtp/film/narration-v3/*.wav
airoli-rtp/film/narration-v3/*.mp3
