# Test screenshots and temp files
*.png
*.jpg
*.jpeg
!autopilot-logo*.png
trim-*.ps1

# Property media: curated photos DO commit (small, and the gallery needs them).
# Videos never do — 78MB of clips belongs in Supabase Storage, not git history.
!media/**/*.jpg
!media/**/*.jpeg
!media/**/*.png
*.mp4
*.MP4
*.mov
*.MOV

# F1 Skymark twin: the audit preview and the stills from Blender commit with the page
!noida-skymark/**/*.png
!noida-skymark/**/*.jpg
*.blend1

# Landlord page (/landlord/, a copy of the f1-skymark-landlord repo): its photos, logos and its two
# short videos (hero reel and ARCIL CEO, about 9 MB) ship with the page, which plays them on iPhone too
!landlord/**/*.jpg
!landlord/**/*.png
!landlord/**/*.mp4


# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
node_modules/
/config.js
.env

# client proposal (third-party PII) & bulky source
*.pdf
prd.txt
osm.xml
osm2.xml

# 4K PNG masters from the upscale pass — working files, served copies live alongside originals
media/_enhanced/

# Indore sign-in backdrop is copied in at build time (scripts/fetch-indore-backdrop.js)
media/indore/backdrop-*.webp

# CMS local development store and uploads (npm run dev:cms)
.cms-dev-store.json
media/_cms-dev/
/docs-out/

# Copernicus surface model tile, fetched by noida-skymark/reconstruction/fetch_context.py
.dsm_*.tif

# Facade textures painted at build time by scripts/world/textures.py
noida-skymark/reconstruction/.tex/
__pycache__/

# F1 Skymark twin builder: .blend files, renders, bakes and GLBs are build output, never committed
noida-skymark/twin/_build/
noida-skymark/twin/web/_review/
noida-skymark/twin/assets/
**/*.blend
**/*.blend1
**/*.raw.glb
**/*.exr

# Reliable Tech Park: CAD intermediates (flattened DWG, ~11 MB per plan) stay local; rebuild with airoli-rtp/G0_RUN.md
airoli-rtp/*/cad_data/
airoli-rtp/twin/_build/
